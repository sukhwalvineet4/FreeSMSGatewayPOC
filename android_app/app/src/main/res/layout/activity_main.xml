<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Free SIM SMS Gateway"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Global SIM Companion App (Zero Disk Logs)"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- SERVER URL INPUT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Central Server URL:"
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1E293B"
        android:hint="e.g. https://brown-mirrors-hunt.loca.lt"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:padding="12dp"
        android:text="https://13864ee946539c.lhr.life"
        android:layout_marginBottom="16dp" />

    <!-- SIM PHONE NUMBER INPUT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Mobile SIM Phone Number:"
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/simNumberInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1E293B"
        android:hint="e.g. +91 9876543210"
        android:textColor="#38BDF8"
        android:textColorHint="#64748B"
        android:inputType="phone"
        android:padding="12dp"
        android:text="+91 9924804021"
        android:layout_marginBottom="20dp" />

    <!-- 1-CLICK CONNECT / DISCONNECT BUTTON -->
    <Button
        android:id="@+id/oneClickConnectButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⚡ ALLOW PERMISSIONS &amp; CONNECT GATEWAY (TURN ON)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:backgroundTint="#10B981"
        android:layout_marginBottom="20dp" />

    <!-- GATEWAY STATUS TEXT -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔴 GATEWAY DISCONNECTED (OFF)"
        android:textColor="#F87171"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- SIM DETAILS TEXT -->
    <TextView
        android:id="@+id/simDetailsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 SIM: Not Connected | Device: Ready"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
